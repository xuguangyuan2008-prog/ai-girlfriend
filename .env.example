# 至少配置一个语音服务。两个都配时页面上会出现下拉框可以切换。
# 所有密钥只在服务端使用，不会发到浏览器。

# 默认使用哪个：openai / doubao（不填则用第一个配置好的）
# VOICE_PROVIDER=doubao

# ---------- OpenAI Realtime ----------
OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1   # 想更快更便宜可用 gpt-realtime-2.1-mini
# OPENAI_VOICE=marin
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ---------- 豆包端到端实时语音大模型（火山引擎 · 豆包语音控制台） ----------
# 控制台里的 APP ID 和 Access Token
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
# 或者使用新版控制台的 API Key（填了就不需要上面两项）
# DOUBAO_API_KEY=
# 音色（完整列表见 server/character.js）。O / O2.0：zh_female_vv_jupiter_bigtts（默认）等；
# SC2.0 官方克隆音色如 saturn_zh_female_wenrouwenya_tob（自带角色设定，不使用本项目的人设）
# DOUBAO_SPEAKER=zh_female_vv_jupiter_bigtts
# 模型版本，对应 dialog.extra.model。官方建议用 O2.0 / SC2.0，具体取值以控制台文档为准；不填用服务端默认
# DOUBAO_MODEL=
# 用户停顿多久算说完（毫秒）
# DOUBAO_END_SMOOTH_MS=800
# DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue

# ---------- 表情标注（豆包需要；OpenAI 不需要） ----------
# 任意 OpenAI 兼容的 Chat Completions 接口，默认火山方舟。不配置则用关键词规则兜底。
# EMOTION_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# EMOTION_API_KEY=
# EMOTION_MODEL=            # 方舟里开通的模型名或推理接入点 ID（ep-xxxx），选便宜快速的小模型即可

# PORT=3000

# ---------- 视频聊天模式（/video.html，MiniMax H3） ----------
# 台词编剧：任意 OpenAI 兼容接口，默认火山方舟。不配置则用固定回复调试
# CHAT_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# CHAT_API_KEY=
# CHAT_MODEL=
# GPU 上 SGLang 服务的地址（不填则为本地调试模式，不生成视频）。部署见 gpu/README.md
# H3_BASE_URL=http://localhost:30000
# H3_API_KEY=                 # 前面有鉴权网关时填写
# H3_MODE=ref                 # ref = ref2va + 8 步加速 LoRA（参考图+声音+首尾帧，默认）；fast = FastH3（最快，只用文字描述，会漂移）。要和 gpu/serve.sh 的 MODE 一致
# H3_SHORT_EDGE=768           # 768 是官方验证的；480 更快，画质需实测
# H3_ASPECT_RATIO=9:16
# H3_DURATION_BUCKETS=4,6,8,10,12,15
# H3_SEED=42                  # 固定种子，帮助保持长相一致
# --- 以下仅 ref 模式 ---
# H3_STEPS=8                  # 配合 8 步加速 LoRA；serve.sh 里 LORA=none 时改回 30~50（FastH3 固定为 5，不用设）
# H3_FLOW_SHIFT=              # 视频时间步偏移，不填为 12；可用 bench --shifts 12,6 对比
# H3_AUDIO_FLOW_SHIFT=        # 音频时间步偏移，不填为 3
# H3_QUALITY=                 # high = 启用 Cache-DiT 跳步
# H3_ASSET_DIR=/workspace/assets   # GPU 机器上的 anchor.png / portrait.png / voice.wav
# MEDIA_DIR=media             # 生成的视频保存目录
